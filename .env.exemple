# Copier ce fichier en .env (jamais versionné).

# Clé gratuite Google AI Studio (sans facturation). Vide = lecture par règles simples seulement.
GEMINI_API_KEY=
# Modèle Gemini disponible sur le palier gratuit (à vérifier dans AI Studio).
GEMINI_MODELE=gemini-3.8-flash
# Modèles essayés si le principal est saturé ou retiré (séparés par des virgules ; vide = aucun).
GEMINI_MODELES_SECOURS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Clé gratuite Groq (console.groq.com, sans carte bancaire). Texte seulement.
GROQ_API_KEY=
GROQ_MODELE=openai/gpt-oss-120b
GROQ_MODELES_SECOURS=llama-3.3-70b-versatile

# Ordre de choix de l'IA, côté serveur (la première disponible lit ; les autres servent de repli).
IA_ORDRE=groq,gemini,ollama
# Transcription des notes vocales (micro, WhatsApp) : Groq Whisper, puis Gemini.
GROQ_MODELE_VOIX=whisper-large-v3-turbo
GEMINI_MODELE_VOIX=gemini-3.5-flash-lite

# Option : modèle local (OLLAMA_ACTIF=1 pour l'utiliser)
OLLAMA_ACTIF=0
OLLAMA_HOTE=http://localhost:11434
OLLAMA_MODELE=qwen2.5:7b

# Mot de passe des comptes de démonstration (données fictives).
DEMO_MOT_DE_PASSE=demo2026

# Clé de signature des sessions : mettre une longue valeur aléatoire.
SECRET_SESSION=

# WhatsApp (API Cloud de Meta) : secret de l'application (signature HMAC des messages reçus)
# et jeton de vérification du webhook. Vides = valeurs aléatoires à chaque démarrage (simulation).
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Simulateur de téléphone (démonstration) : 0 pour le couper en production.
SIMULATEUR_ACTIF=1
# Nombre maximal d'espaces d'entreprise créés par inscription sur ce prototype.
ESPACES_MAX=20
